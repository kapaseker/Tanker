{
  // 直行速度单位为米/秒，车体转向速度单位为度/秒。
  "driving": { "forward_speed": 16.0, "reverse_speed": 8.0, "turn_speed_deg_s": 90.0 },
  // 玩家出生时的满血点数。
  "max_health": 100,
  // 碰撞外部尺寸按长、高、宽排列，单位：米。
  "collision": { "size": [7.68, 2.68, 3.76], "rounding_radius": 0.2 },
  // 豹 2A6 / L55 主炮公开俯仰范围：−9°～+20°。
  // 军方来源：https://www.mod.gov.sk/data/files/1420.pdf#page=25 （印刷页26）。
  // 炮塔水平全周 360°；运行时回绕，不限制为车体朝前的某个扇区。
  // 速度是临时游戏采用值，并非已核实的 A6 实车精确速度：
  // 参考 VINCORION 大口径系统系列的瞄准速度下界（水平≥30、俯仰≥9°/秒）。
  // 原厂系列资料：https://www.vincorion.com/wp-content/uploads/2022/04/220627_VINC_DB_GTD_chaserV_EN_DINA4_WEB.pdf
  // 该链接现404，表格来自搜索索引；A6 专属手册尚未取得。完整核查及限制见
  // docs/references/leopard-2a6-articulation.md，核查日期 2026-11-02。
  // shortcut: 全周共用俯仰限位，取得 A6 方位限位资料后补充车尾防碰撞联锁。
  "articulation": {
    // 水平全周且可连续旋转；当前仅支持 360 度，不表示 ±180 度机械限位。
    "traverse_range_deg": 360.0,
    // 两轴均为度/秒，按住即以该速度运动，松开停止。
    "traverse_speed_deg_s": 30.0,
    "elevation_speed_deg_s": 9.0,
    "min_elevation_deg": -9.0,
    "max_elevation_deg": 20.0
  }
}
